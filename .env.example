# J4U Arcade — application configuration
# Copy this file to .env and fill in real values. .env is NEVER committed.
# Without .env the app still opens and plays in guest mode; login and
# personal letters are simply unavailable.

# Comma-separated list of usernames allowed to log in (case-insensitive)
APP_VALID_USERS=name1,name2

# Login password
APP_PASSWORD=0000

# ==== PERSONAL LETTERS ====
# Conventions: {name} = entered username ; \n = line break (rendered as <br>)
# If LETTER_GUEST is missing, a short default greeting is shown.

LETTER_GUEST=Hi {name},\nYour letter content goes here...

LETTER_SPECIAL_1=Letter part 1 after successful login...

LETTER_SPECIAL_2=Letter part 2...

LETTER_SPECIAL_3=Letter part 3 (finale)...

# ==== DATA ====
# Local SQLite file used for offline score storage
DB_PATH=anni.db

# Backend base URL. When set, scores go to the server first and fall back to
# SQLite if unreachable. Leave empty for fully offline play.
# API_URL=http://localhost:8080/api
