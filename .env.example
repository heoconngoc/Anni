# Anni Arcade — cấu hình app
# Sao chép file này thành .env và điền giá trị thật. .env KHÔNG được commit.
# Thiếu .env: app vẫn mở và chơi được ở chế độ khách, nhưng không login được.

# Danh sách username hợp lệ, phân tách bằng dấu phẩy (không phân biệt hoa/thường)
APP_VALID_USERS=ten1,ten2

# Mật khẩu login
APP_PASSWORD=0000

# ==== CÁC BỨC THƯ ====
# Quy ước: {name} = tên người dùng nhập ; \n = xuống dòng (thành <br> trong JLabel)
# Nếu thiếu LETTER_GUEST sẽ hiển thị thư chào mặc định ngắn.

LETTER_GUEST=Xin chào {name},\nNội dung bức thư của bạn ở đây...

LETTER_SPECIAL_1=Nội dung thư phần 1 sau khi đăng nhập thành công...

LETTER_SPECIAL_2=Nội dung thư phần 2...

LETTER_SPECIAL_3=Nội dung thư phần 3 (kết)...
DB_PATH=anni.db
